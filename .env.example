# Neo4j Aura credentials
# Copy this file to .env and fill in your values (gitignored)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here


# OpenRouter Credentials
OPENROUTER_API_KEY=sk-or-v1-your-api-key

# Azure Container Apps Deployment (Pulumi infra/azure)
AZURE_LOCATION=eastus
AZURE_CONTAINER_APP_CORE_IMAGE=ghcr.io/nomos-n4s/nomos:0.11.1
AZURE_RESOURCE_GROUP_NAME=nomos-rg-dev
